package components

import "frontend/models"

templ Form() {
	<form
		x-data="{
        workspace_name: '',
        stack: 'Node',
        golet_id: '',

        startWS() {
            loading = true;

            const url = `/userBackend?workspace_name=${this.workspace_name}&stack=${this.stack}`;

            // set ws-connect dynamically
            this.$refs.wsbox.setAttribute('ws-connect', url);

            // force htmx to process it
            htmx.process(this.$refs.wsbox);
        }
    }"
		@submit.prevent="startWS()"
		@click.outside="open = false"
		x-show="open"
		x-transition
		class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 
           bg-slate-800 text-white p-6 w-96 rounded-2xl shadow-2xl 
           flex flex-col gap-5 border border-slate-700"
	>
		<!-- Title -->
		<h2 class="text-xl font-semibold text-center">
			Create Workspace
		</h2>
		<!-- Workspace Name -->
		<div class="flex flex-col gap-1 w-full">
			<label class="text-sm text-slate-300">Workspace Name</label>
			<input
				type="text"
				x-model="workspace_name"
				name="workspace_name"
				placeholder="weber"
				class="px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 
                   focus:outline-none focus:ring-2 focus:ring-blue-500 
                   placeholder:text-slate-400"
			/>
		</div>
		<!-- Stack Selection -->
		<div class="flex flex-col gap-1 w-full">
			<label class="text-sm text-slate-300">Select Stack</label>
			<select
				name="stack"
				x-model="stack"
				class="px-3 py-2 rounded-lg bg-slate-700 border border-slate-600 
                   focus:outline-none focus:ring-2 focus:ring-blue-500"
			>
				<option value="Node">Node Stack</option>
				<option value="React">React Stack</option>
				<option value="Go">Go Stack</option>
			</select>
		</div>
		<!-- Buttons -->
		<div class="flex justify-end gap-3 mt-2">
			<button
				type="button"
				@click="open = false"
				class="px-4 py-2 rounded-lg bg-slate-600 hover:bg-slate-500 transition"
			>
				Cancel
			</button>
			<button
				type="submit"
				class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 
                   transition font-medium"
			>
				<span>Create</span>
			</button>
		</div>
		<!-- WebSocket handler (INSIDE form) -->
		<div
			x-ref="wsbox"
			hx-ext="ws"
			x-init="
            $refs.wsbox.addEventListener('htmx:wsAfterMessage', (event) => {
                const data = JSON.parse(event.detail.message);

                // ✅ update Alpine state
                this.golet_id = data.golet_id;
                this.workspace_name = data.workspace_name;
				console.log(data)

                console.log('WS received:', data);

                // 🔥 call backend after WS response
              	window.location.href = `/start?golet_id=${this.golet_id}&workspace_name=${this.workspace_name}`;
            });
        "
		></div>
	</form>
}

templ ContexualMenu(stacks []models.Stack) {
	<div class=" w-full max-h-250 min-h-200  rounded-2xl   gap-5 items-center justify-center flex-wrap flex">
		for _, item := range stacks {
			{{ hx_post := "/user_recreation?username=" + item.Username + "&workspace_name=" + item.WorkspaceName }}
			<div
				hx-post={ hx_post }
				class="h-60 w-80 text-sm"
			>
				<div class="bg-zinc-800 rounded-tl-2xl rounded-tr-2xl w-full h-8/10 flex justify-center items-center">
					<img class="w-30 h-30" src="/public/nodejs.png" alt="nodejs" class=""/>
				</div>
				<div class="bg-zinc-900 p-3 rounded-bl-2xl rounded-br-2xl">
					<div class="rounded-xl w-45 h-auto text-lg">{ item.WorkspaceName }</div>
					<span class="rounded-xl w-45 h-auto">{ item.Stack }</span>
					<span class="rounded-xl w-45 h-auto pl-20">{ item.Lastupdated.Format("2006-01-02 15:04:05") }</span>
				</div>
			</div>
		}
		<div
			@click="open = true"
			class="h-60 w-80 text-sm rounded-2xl bg-zinc-800 flex justify-center items-center"
		>
			<img class="w-30 h-30" src="/public/plus.png" alt="nodejs" class=""/>
		</div>
	</div>
}

templ User(stacks []models.Stack) {
	<div class="" x-data="{loading: false}">
		<div
			x-data="{ open: false }"
			class="bg-stone-900 text-white w-full h-full "
			x-show="!loading"
		>
			@ContexualMenu(stacks)
			@Form()
		</div>
		@Loading()
	</div>
}
